# Copy to .env (or .env.production) and adjust. Read at build time by Vite.

# Where the public website API lives (built in the ID-Indetails backend).
# Default: /api/public/website on the site's own origin, which needs the web server to proxy /api to the API.
# Set an absolute URL when the API is on another origin; the API must then allow this site's origin (CORS).
# VITE_API_BASE_URL=https://api.example.com/api/public/website

# Development only (npm run dev / preview): where the dev server forwards /api/public/website.
# Default: the local API's "https" profile, https://localhost:7187 (its "http" profile is http://localhost:5164).
# Pointed at the live site, the local contact form reaches the real inbox.
# DEV_API_TARGET=https://id-indetails.com

# Google Analytics 4 measurement ID (G-...). Set only for the production build (the Publish workflow passes the
# repository variable GA_MEASUREMENT_ID). Without it nothing is tracked and visitors are never asked about cookies.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
